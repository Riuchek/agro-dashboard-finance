# API bind address (localhost only — see ADR-007)
HTTP_ADDR=127.0.0.1:8080

# Redis (leave empty to use in-memory cache for local dev without Docker)
REDIS_URL=redis://127.0.0.1:6379/0

# External provider tokens (backend only — never expose to the browser)
BRAPI_TOKEN=
HG_BRASIL_TOKEN=

# Comma-separated CORS allowlist for the Next.js frontend
CORS_ALLOW_ORIGINS=http://localhost:3000
